# Firebase Web Config (ambil dari Firebase Console -> Project Settings -> Your Apps -> Web)
# Salin nilai dari project kamu lalu isi di bawah ini, lalu ganti nama file jadi .env
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=https://smart-traffic-vision-app-default-rtdb.asia-southeast1.firebasedatabase.app/
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL tempat ai_server.py dijalankan (AI server). Dipakai untuk:
#  - upload gambar artikel (POST /api/upload -> static/uploads)
#  - endpoint deteksi / status CCTV
# Wajib berupa URL publik (tunnel/port-forward/host) jika frontend di-deploy ke Vercel
# agar gambar & API bisa diakses pengunjung.
VITE_AI_SERVER_URL=http://localhost:5000

# (Opsional) Prefix untuk gambar artikel lama yang tersimpan sebagai nama file.
# Jika kosong, otomatis memakai VITE_AI_SERVER_URL.
VITE_IMAGE_BASE_URL=

# Supabase (data artikel + upload gambar artikel -> URL publik)
# 1) Buat project di https://supabase.com (gratis 500MB)
# 2) Storage -> New bucket -> nama: Image Artikel -> centang "Public bucket"
# 3) SQL Editor -> jalankan supabase.sql untuk membuat tabel `artikel` + RLS policy
# 4) Project Settings -> API: salin "Project URL" dan "anon public" key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=Image Artikel
